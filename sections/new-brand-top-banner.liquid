<style>
.beauty-section {
  padding-top: {{ section.settings.padding_top_desktop }}px;
  padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
  background: #fff;
}

.beauty-wrapper {
  margin: 0 auto;
  text-align: center;
  position: relative;
}

.beauty-text {
  position: absolute;
  left: 50%;
  top: clamp(30px, 5.28vw, 76px);
  transform: translate(-50%);
}
/* TEXT */
.beauty-label {
  display: inline-flex;
  justify-content: center;
  background: #FFC9D5;
  align-items: center;
  padding: 6px 17px;
  border-radius: 30px;
  letter-spacing: 2px;
  margin-bottom: 20px;
  color: #7E515B;
  text-align: center;
  font-size: clamp(12px, 0.97vw, 14px);
  gap: 10px;
  letter-spacing: 4.2px;
  text-transform: uppercase;
}

.beauty-heading {
  color: #0A0A0A;
  text-align: center;
  font-family: "Vinila Condensed";
  font-style: normal;
  font-weight: 400;
}

.beauty-heading-bottom-text {
  font-style: italic;
  font-size: 7vw;
  color: #0A0A0A;
  text-align: center;
  font-family: "Vinila Condensed";
  font-size: clamp(42px, 7.36vw, 106px);
  font-weight: 700;
  line-height: clamp(40px, 6.6vw, 96px);
  letter-spacing: -2.4px;
}

.beauty-heading-top-text {
  color: #0A0A0A;
  text-align: center;
  font-family: "Vinila Condensed";
  font-size: clamp(40px, 6.6vw, 96px);
  font-style: normal;
  font-weight: 400;
  line-height: clamp(40px, 6.6vw, 96px);
  letter-spacing: -2.4px;
}


.beauty-subtext {
  max-width: 700px;
  margin: clamp(20px, 2.36vw, 34px) auto clamp(24px, 2.78vw, 40px);
  color: #5B5B5B;
  text-align: center;
  font-family: "Elza Trial";
  font-size: clamp(16px, 1.39vw, 20px);
}

/* IMAGE */
.beauty-image img {
  width: 100%;
  height: auto;
}

/* Show Desktop Image by default */
.mobile-image {
  display: none;
}

/* Mobile */
@media screen and (max-width: 768px) {
  .beauty-text {
    top: 50px;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
    left: unset;
    padding: 0 30px;
    transform: unset;
  }

  .beauty-section {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  .beauty-heading {
    font-size: 32px;
  }

  .beauty-subtext {
    font-size: 15px;
  }

   .beauty-label {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    font-size: 11px;
    letter-spacing: 2.2px;
    text-transform: uppercase;
  }      
  
  .beauty-heading-top-text {
    font-size: 44px;
    line-height: 38px;
  }

  .beauty-heading-bottom-text {
    font-size: 46px;
    line-height: 48px;
    letter-spacing: 0;
  }

  .beauty-subtext {
    margin: 8px auto;
    font-size: 16px;
    font-weight: 500;
    line-height: 18px;
  }

  .desktop-image {
    display: none;
  }

  .mobile-image {
    display: block;
  }
}
</style>

<section class="beauty-section">
  <div class="beauty-wrapper">

    <!-- TEXT CONTENT -->
    <div class="beauty-text">
      {% if section.settings.small_text != blank %}
        <span class="beauty-label">
          {{ section.settings.small_text }}
        </span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="beauty-heading">
          <span class="beauty-heading-top-text">{{ section.settings.heading }}</span>
          <br>
          <span class="beauty-heading-bottom-text">{{ section.settings.highlitedHeading }}</span>
        </h2>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <p class="beauty-subtext">
          {{ section.settings.subtext }}
        </p>
      {% endif %}
    </div>

    <!-- IMAGE -->
    <div class="beauty-image">
      {% if section.settings.desktop_image != blank %}
        <img 
          class="desktop-image"
          src="{{ section.settings.desktop_image | image_url: width: 2000 }}"
          alt=""
          loading="lazy"
        >
      {% endif %}

      {% if section.settings.mobile_image != blank %}
        <img 
          class="mobile-image"
          src="{{ section.settings.mobile_image | image_url: width: 1000 }}"
          alt=""
          loading="lazy"
        >
      {% endif %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Brand Top Banner",
  "settings": [
    {
      "type": "text",
      "id": "small_text",
      "label": "Top Label",
      "default": "SINCE 2012"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Beauty is a "
    },
    {
      "type": "text",
      "id": "highlitedHeading",
      "label": "Highlited Heading",
      "default": "conversation"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Sub Text",
      "default": "Between you and the brands that understand your story. Each one crafted by dreamers, believers, and artists."
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Desktop Padding Top",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Desktop Padding Bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile Padding Top",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile Padding Bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "Brand Top Banner"
    }
  ]
}
{% endschema %}