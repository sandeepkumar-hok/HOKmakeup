<style>
.collection-progress-section {
  padding: 60px 0;
}

.section-heading {
  text-align: center;
  margin-bottom: 40px;
  font-size: 28px;
}

.combo-product-card {
  border-radius: 8px;
  text-align: center;
  height: 100%;
  border-radius: 4px;
  border: 1px solid #E7E7E7;
}

.product-image {
  overflow: hidden;
  max-height: 253px;
}

.product-image img {
  width: 100%;
  border-radius: 6px;
  transition: transform 0.4s ease;
  height: auto;
}

.product-image img:hover {
  transform: scale(1.2);
}

.product-info {
 padding: 0 34px;
}

.product-info h3 {
  font-size: 16px;
  margin: 24px 0 0;
  font-weight: 700;
  white-space: nowrap; 
  overflow: hidden;
  text-overflow: ellipsis;
}

.combo-btn {
  display: inline-block;
  padding: 10px 20px;
  border: 1px solid #000;
  border-radius: 30px;
  text-decoration: none;
  font-size: 14px;
  transition: 0.3s;
}

.combo-btn:hover {
  background: #000;
  color: #fff;
}

.swiper-pagination {
  position: relative !important;
  margin-top: 30px;
  height: 3px;
  background: #e5e5e5;
}

.swiper-pagination-progressbar-fill {
  background: #000 !important;
}

.view-all-wrapper {
  text-align: center;
  margin-top: 40px;
}

.view-all-btn {
  display: inline-block;
  padding: 14px 40px;
  border: 1px solid #000;
  border-radius: 40px;
  text-decoration: none;
  font-weight: 600;
  transition: 0.3s;
}

.view-all-btn:hover {
  background: #000;
  color: #fff;
}

.view-all-wrapper .button-cta {
  padding: 1vw 10vw;
  width: fit-content;
  font-weight: 800;
}
.view-combo .button-cta {
  padding: .3vw 1.5vw;
  width: fit-content;
  text-transform: capitalize;
  color: #000;
  text-align: center;
  font-family: 'Mosvita';
  font-size: 16px;
  font-style: normal;
  font-weight: 700;
  line-height: normal;
  margin-bottom: 30px;
}

.product-combo-info {
  color: #000;
  text-align: center;
  font-family: 'Mosvita';
  font-size: 14px;
  font-style: normal;
  font-weight: 500;
  line-height: normal;
  min-height: 72px; 
  padding: 16px 0;
  display: block !important;
}

@media screen and (max-width: 768px) {
    .view-combo .button-cta {
      padding: 5px 25px;
      font-size: 14px;
    }
    .view-all-wrapper .button-cta {
      padding: 12px 52px;
      font-size: 14px;
    }
    .product-info {
      padding: 0 16px;
    }
    .product-info h3 {
      margin: 20px 0 0;
    }
    .view-combo .button-cta {
      margin-bottom: 20px;
    }
    .product-combo-info {
      padding: 12px 0;
      font-size: 12px;
    }
}
</style>

<section class="collection-progress-section">
  <div class="container">

    {% if section.settings.heading != blank %}
      <h2 class="section-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% assign collection = collections[section.settings.collection] %}

    {% if collection != blank %}

      <div class="swiper collectionSwiper">
        <div class="swiper-wrapper">

          {% for product in collection.products limit: section.settings.products_limit %}
            <div class="swiper-slide">
              <div class="combo-product-card">
                
                <a href="{{ product.url }}">
                  <div class="product-image">
                    {{ product.featured_image | image_url: width: 600 | image_tag }}
                  </div>
                </a>

                <div class="product-info">
                  <a href="{{ product.url }}">
                    <h3>{{ product.title }}</h3>
                    <p class="product-combo-info">{{ product.metafields.custom.combo_product_benefits.value }}</p>
                  </a>

                  <div class="view-combo">
                    <a href="{{ product.url }}" class="b-add_to_bag-button button-cta atc pocket">
                        View Combo
                    </a>
                  </div>
                </div>

              </div>
            </div>
          {% endfor %}

        </div>

        <div class="swiper-pagination"></div>
      </div>

      <div class="view-all-wrapper">
        <a href="{{ collection.url }}" class="b-add_to_bag-button button-cta atc pocket">
          {{ section.settings.view_all_text }}
        </a>
      </div>

    {% else %}
      <p>Please select a collection in section settings.</p>
    {% endif %}

  </div>
</section>


<script>
  document.addEventListener("DOMContentLoaded", function () {
    new Swiper(".collectionSwiper", {
      slidesPerView: 1.5,
      spaceBetween: 20,
      speed: 800,

      pagination: {
        el: ".collectionSwiper .swiper-pagination",
        type: "progressbar",
      },

      breakpoints: {
        768: {
          slidesPerView: 1.5
        },
        1024: {
          slidesPerView: 3.2
        },
        1280: {
          slidesPerView: 3.2
        }
      }
    });
  });
</script>

{% schema %}
{
  "name": "Combo Coll ProgressBar",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Shop Combos"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Number of products to show",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Button Text",
      "default": "VIEW ALL"
    }
  ],
  "presets": [
    {
      "name": "Combo Coll ProgressBar"
    }
  ]
}
{% endschema %}

