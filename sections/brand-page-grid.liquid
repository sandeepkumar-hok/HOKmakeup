        { "type": "textarea", "id": "top_description", "label": "top description", "default": "UK beauty brand" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "text", "id": "button_text", "label": "Button Text", "default": "Shop Now" },
        { "type": "url", "id": "redirect_url", "label": "Redirect URL" }
      ]
    }
  ],
  "presets": [
    { "name": "Meet Our Brands" }
  ]
